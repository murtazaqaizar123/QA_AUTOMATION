# ── LLM: OpenRouter (for Gemma reasoning) ──────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-3-27b-it

# ── Embeddings: Ollama ───────────────
OLLAMA_BASE_URL=http://your-ollama-url
OLLAMA_BASE_API=your-api-key
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_LLM_MODEL=

# ── Qdrant Vector Store ────────────────────────────────────────────────────
QDRANT_URL=https://your-qdrant-url
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_SEMANTIC_COLLECTION=qa_semantic_facts
QDRANT_PROCEDURAL_COLLECTION=qa_procedural_rules

# ── LangGraph Checkpointer (SQLite for dev) ────────────────────────────────
SQLITE_DB_PATH=./qa-factory.sqlite

# ── Workspace ─────────────────────────────────────────────────────────────
PROJECTS_REGISTRY_PATH=../projects.json

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
